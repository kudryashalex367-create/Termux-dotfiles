{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "android_small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ❯ ",
        "color": {
            "keys": "#a78bfa",
            "title": "#c4b5fd"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS       "
        },
        {
            "type": "kernel",
            "key": "Kernel   "
        },
        {
            "type": "shell",
            "key": "Shell    "
        },
        {
            "type": "terminal",
            "key": "Terminal "
        },
        {
            "type": "memory",
            "key": "Memory   "
        },
        {
            "type": "battery",
            "key": "Battery  "
        },
        {
            "type": "uptime",
            "key": "Uptime   "
        },
        "break",
        "colors"
    ]
}
